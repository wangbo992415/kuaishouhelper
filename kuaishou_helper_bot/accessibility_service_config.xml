<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置文件
  关键安全设置：
  - canPerformGestures="false"  → 禁止模拟手势（这是和违规外挂的根本区别）
  - canRequestTouchExploration="false" → 禁止触摸探索
  - 仅声明读取窗口内容的权限
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1500"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:canRequestTouchExploration="false"
    android:canRequestEnhancedWebAccessibility="false"
    android:canTakeScreenshot="true"
    android:description="@string/service_description"
    android:summary="@string/service_summary"
    android:packageNames="com.kuaishou.nebula,com.kuaishou.nebula.lite" />
